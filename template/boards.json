            "chip": "bcm2712",
            "arch": "64",
            "target": "aarch64-unknown-none-softfloat",
            "kernel": "kernel8.img",
            "load_addr": "0x80000",
            "nightly": false,
            "config_txt": "arm_64bit=1\nkernel=kernel8.img\n# rpi-hal links AArch64 images at 0x80000; don't rely on the firmware's\n# default for an image without a Linux header.\nkernel_address=0x80000\n# Without this the firmware refuses a kernel it can't match to a device\n# tree on the card, and nothing here is a Linux kernel.\nos_check=0\n# Leave the PCIe link to the RP1 chip trained up rather than resetting it\n# before the kernel starts: the console's GPIO14/15, like every header\n# pin, are on RP1, and rpi-hal has no PCIe driver of its own.\npciex4_reset=0\n",
            "firmware_url": "https://raw.githubusercontent.com/raspberrypi/firmware/1.20260824/boot",
