    {
      "id": "pi-zero",
      "name": "Raspberry Pi Zero (Zero, Zero W)",
      "arches": [
        "armv6"
      ],
      "variants": {
        "armv6": {
          "vars": {
            "board_name": "Raspberry Pi Zero (Zero, Zero W)",
            "chip": "bcm2835",
            "arch": "armv6",
            "target": "armv6-none-eabi",
            "kernel": "kernel.img",
            "load_addr": "0x8000",
            "nightly": true,
            "config_txt": "# The PL011 console's divisors assume a 48MHz reference clock, and a\n# firmware that chose another scales every bit period. Pin it.\n#\n# No arm_64bit line: the ARM1176 has no 64-bit mode, and a stray\n# `arm_64bit=1` sends the firmware looking for kernel8.img.\n#\n# A Zero W's Bluetooth claims the PL011 by default; rpi-hal's\n# `Uart::init` remuxes GPIO14/15 back to it, so nothing is needed here.\ninit_uart_clock=48000000\ndisable_splash=1\n",
            "firmware_url": "https://raw.githubusercontent.com/raspberrypi/firmware/1.20260824/boot",
            "firmware_files": "bootcode.bin start.elf fixup.dat LICENCE.broadcom",
            "loader_url": "https://github.com/joeferner/rpi-loader/releases/download/v0.5.0",
            "loader_image": "rpi-loader-0.5.0-bcm2835-kernel.img",
